{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "EnforceAdminMfa": false
  },
  "RateLimiting": {
    "AuthPermitLimit": 1000,
    "AuthWindowSeconds": 60
  },
  "Jobs": {
    "Enabled": false
  },
  "DataProtection": {
    "KeyVaultKeyUri": ""
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownProxies": [],
    "KnownNetworks": [],
    "ForwardLimit": 1
  }
}
