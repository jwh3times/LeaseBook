{
  "name": "leasebook-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:format": "prettier --write \"../*.md\" \"../docs/**/*.md\" \"../infra/**/*.md\" \"../.github/**/*.md\" \"../.claude/agents/**/*.md\" \"../.agents/**/*.md\" \"../scripts/*.mjs\" \"../.markdownlint-cli2.jsonc\" \"../cspell.json\"",
    "docs:format:check": "prettier --check \"../*.md\" \"../docs/**/*.md\" \"../infra/**/*.md\" \"../.github/**/*.md\" \"../.claude/agents/**/*.md\" \"../.agents/**/*.md\" \"../scripts/*.mjs\" \"../.markdownlint-cli2.jsonc\" \"../cspell.json\"",
    "docs:lint": "markdownlint-cli2 \"../*.md\" \"../docs/**/*.md\" \"../infra/**/*.md\" \"../.github/**/*.md\" \"../.claude/agents/**/*.md\" \"../.agents/**/*.md\"",
    "docs:spell": "cspell lint --config ../cspell.json --quiet",
    "docs:policy": "node ../scripts/check-docs.mjs",
    "docs:policy:test": "node --test ../scripts/check-docs.test.mjs",
    "docs:check": "npm run docs:format:check && npm run docs:lint && npm run docs:spell && npm run docs:policy:test && npm run docs:policy",
    "sync:agents": "node ../scripts/sync-agent-mirrors.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:generate": "npm --prefix codegen ci && node ../scripts/emit-openapi.mjs && npm --prefix codegen run generate",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@tanstack/react-virtual": "^3.14.13",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cspell": "10.3.3",
    "jsdom": "^30.1.0",
    "markdownlint-cli2": "0.23.2",
    "msw": "^2.15.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prettier": "^3.9.8",
    "typescript": "~7.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "markdownlint-cli2": {
      "smol-toml": "1.7.1"
    }
  }
}
