{
  "name": "leasebook-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:format": "prettier --write \"../*.md\" \"../docs/**/*.md\" \"../infra/**/*.md\" \"../.github/**/*.md\" \"../.claude/agents/**/*.md\" \"../scripts/*.mjs\" \"../.markdownlint-cli2.jsonc\" \"../cspell.json\"",
    "docs:format:check": "prettier --check \"../*.md\" \"../docs/**/*.md\" \"../infra/**/*.md\" \"../.github/**/*.md\" \"../.claude/agents/**/*.md\" \"../scripts/*.mjs\" \"../.markdownlint-cli2.jsonc\" \"../cspell.json\"",
    "docs:lint": "markdownlint-cli2 \"../*.md\" \"../docs/**/*.md\" \"../infra/**/*.md\" \"../.github/**/*.md\" \"../.claude/agents/**/*.md\"",
    "docs:spell": "cspell lint --config ../cspell.json --quiet",
    "docs:policy": "node ../scripts/check-docs-policy.mjs && node ../scripts/check-docs.mjs",
    "docs:policy:test": "node --test ../scripts/check-docs-policy.test.mjs ../scripts/check-docs.test.mjs",
    "docs:check": "npm run docs:format:check && npm run docs:lint && npm run docs:spell && npm run docs:policy:test && npm run docs:policy",
    "sync:agents": "node ../scripts/sync-agents.mjs",
    "sync:agents:check": "node ../scripts/sync-agents.mjs --check",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "api:generate": "npm --prefix codegen ci && node ../scripts/emit-openapi.mjs && npm --prefix codegen run generate",
    "e2e": "playwright test",
    "e2e:coverage": "node ../scripts/e2e-coverage.mjs",
    "e2e:fresh": "node ../scripts/e2e-db.mjs run"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "cspell": "10.4.1",
    "jsdom": "^31.0.0",
    "markdownlint-cli2": "0.24.0",
    "monocart-coverage-reports": "3.2.1",
    "msw": "^3.0.4",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.9.10",
    "typescript": "~7.0",
    "vite": "^8.3.6",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "markdownlint-cli2": {
      "markdown-it": "15.0.3",
      "re2js": "2.8.7",
      "smol-toml": "1.9.0"
    },
    "micromark-extension-math": {
      "katex": "0.18.11"
    }
  },
  "allowScripts": {
    "msw": false
  }
}
