<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="CsCheck" />
    <!-- Container-backed (Testcontainers via Tests.Common): the engines take advisory locks and read
         under RLS, so they run against the real schema, as the app role, with no host booted. -->
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module Stryker mutates against this project (ADR-055 addendum, docs/testing/mutation.md).
         Its engines are tested here directly, behind recording stand-ins for the ports, so a mutant
         reruns these tests and not the integration suite, which boots the host. -->
    <ProjectReference Include="..\..\src\LeaseBook.Modules.Payments\LeaseBook.Modules.Payments.csproj" />
    <ProjectReference Include="..\LeaseBook.Tests.Common\LeaseBook.Tests.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
