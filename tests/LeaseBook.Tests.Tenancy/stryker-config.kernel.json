{
  "stryker-config": {
    "project": "LeaseBook.SharedKernel.csproj",
    "test-runner": "mtp",
    "configuration": "Debug",
    "coverage-analysis": "all",
    "timeout-ratio": 4,
    "concurrency": 4,
    "reporters": ["json", "html", "cleartext", "progress"],
    "mutation-level": "Standard",
    "thresholds": { "high": 80, "low": 60, "break": 0 },
    "mutate": ["**/Tenancy/**/*.cs", "!**/obj/**"]
  }
}
